/* Plugin generated by AMXX-Studio */

#include <amxmodx>
#include <amxmisc>
#include <hamsandwich>
#include <fun>

#define PLUGIN "Change Health"
#define VERSION "1.0"
#define AUTHOR "Muhammad_Furqon>>>apasajalah12.blogspot.com"

new g_health

public plugin_init()
{
	RegisterHam(Ham_Spawn, "player", "fwHamPlayerSpawnPost", 1)
	
	register_plugin(PLUGIN, VERSION, AUTHOR)
	
	g_health = register_cvar("Extra_Health", "100")
}

public fwHamPlayerSpawnPost(id)
{
	if (is_user_bot(id))
	{
		set_user_health(id, 100)
	}
	
	new hp = get_pcvar_num(g_health)
	
	if (is_user_alive(id))		
		
	if(get_user_health(id) > 100)
	{
		set_user_health(id, 100)
		return PLUGIN_CONTINUE
	}		
	set_user_health(id, get_user_health(id) + hp)
	return PLUGIN_HANDLED
}
